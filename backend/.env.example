DATABASE_URL=sqlite:///./mediscan.db
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# nih14 = show NIH ChestX-ray14 multi-label (recommended)
# grouped = roll up via backend/app/ml/pathologies.py GROUP_MAP
CLASSIFICATION_MODE=nih14

# Score cutoff for marking a pathology as positive (0–1)
PATHOLOGY_THRESHOLD=0.5

# TorchXRayVision weights
INFERENCE_MODEL_NAME=densenet121-res224-all

# Clinical assistant (Groq). Leave empty to disable chat until configured.
# Get a key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Tried in order when the primary model hits the free-tier rate limit (429)
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
GROQ_MAX_TOKENS=600
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
