DATABASE_URL=sqlite:///./mediscan.db
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# nih14 = show NIH ChestX-ray14 multi-label (recommended)
# grouped = roll up via backend/app/ml/pathologies.py GROUP_MAP
CLASSIFICATION_MODE=nih14

# Score cutoff for marking a pathology as positive (0–1)
PATHOLOGY_THRESHOLD=0.55

# TorchXRayVision weights
INFERENCE_MODEL_NAME=densenet121-res224-all
